<?xml version="1.0"?>
<!--
  arm_6dof.urdf
  =============
  6-DOF desktop arm matching the DH parameters in arm_config.yaml:

    Joint | d (m) | a (m) | alpha (rad) | description
    ======+=======+=======+=============+==================
      1   | 0.15  | 0.00  |  pi/2       | base rotation (yaw)
      2   | 0.00  | 0.14  |  0          | shoulder pitch
      3   | 0.00  | 0.14  |  0          | elbow pitch
      4   | 0.00  | 0.00  |  pi/2       | wrist roll
      5   | 0.12  | 0.00  | -pi/2       | wrist pitch
      6   | 0.06  | 0.00  |  0          | end-effector rotate

  All lengths are in metres (URDF/Gazebo convention). The Python side
  (ik_solver.py, arm_config.yaml) works in centimetres, so 1 cm = 0.01 m.

  Fixed camera link is mounted 0.30 m above the base, looking straight
  down, matching camera.position_xyz_cm / rotation_rpy_deg in
  arm_config.yaml.

  Load with Gazebo Sim (Jazzy) via launch_sim.py, or visualize with RViz
  via the urdf_launch package's display.launch.py.
-->
<robot name="arm_6dof" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="arm_grey">
    <color rgba="0.55 0.57 0.60 1.0"/>
  </material>
  <material name="joint_orange">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>
  <material name="ee_dark">
    <color rgba="0.15 0.15 0.17 1.0"/>
  </material>
  <material name="camera_blue">
    <color rgba="0.10 0.30 0.85 1.0"/>
  </material>

  <!-- ══════════════════════════ World / base ══════════════════════════ -->

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.02"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ══════════════════════════ Joint 1 — base rotation (yaw), d=0.15 ══ -->

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="10" velocity="2.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.13"/></geometry>
      <material name="joint_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.045" length="0.13"/></geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <origin xyz="0 0 0.065"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- ══════════════════════════ Joint 2 — shoulder pitch, a=0.14 ═══════ -->

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="2.0944" effort="10" velocity="2.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.025" length="0.14"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.025" length="0.14"/></geometry>
    </collision>
    <inertial>
      <mass value="0.30"/>
      <origin xyz="0.07 0 0"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0012"/>
    </inertial>
  </link>

  <!-- ══════════════════════════ Joint 3 — elbow pitch, a=0.14 ══════════ -->

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.14 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="8" velocity="2.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.022" length="0.14"/></geometry>
      <material name="joint_orange"/>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.022" length="0.14"/></geometry>
    </collision>
    <inertial>
      <mass value="0.22"/>
      <origin xyz="0.07 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0009"/>
    </inertial>
  </link>

  <!-- ══════════════════════════ Joint 4 — wrist roll ═══════════════════ -->

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.14 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="4" velocity="3.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.020" length="0.04"/></geometry>
      <material name="arm_grey"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.020" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <origin xyz="0.02 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ══════════════════════════ Joint 5 — wrist pitch, d=0.12 ══════════ -->

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="4" velocity="3.0"/>
  </joint>

  <link name="link5">
    <visual>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.018" length="0.12"/></geometry>
      <material name="joint_orange"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.018" length="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <origin xyz="0.06 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <!-- ══════════════════════ Joint 6 — end-effector rotate, d=0.06 ══════ -->

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="end_effector_link"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="2" velocity="3.0"/>
  </joint>

  <link name="end_effector_link">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.015" length="0.06"/></geometry>
      <material name="ee_dark"/>
    </visual>
    <!-- simple two-finger gripper, purely cosmetic -->
    <visual>
      <origin xyz="0.062 0.018 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.008 0.02"/></geometry>
      <material name="ee_dark"/>
    </visual>
    <visual>
      <origin xyz="0.062 -0.018 0" rpy="0 0 0"/>
      <geometry><box size="0.03 0.008 0.02"/></geometry>
      <material name="ee_dark"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.015" length="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0.03 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ══════════════════════════ Fixed overhead camera ══════════════════ -->
  <!-- Matches arm_config.yaml: camera.position_xyz_cm [0,0,30], pointing down -->

  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.30" rpy="0 1.5708 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
      <material name="camera_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_link_optical"/>

  <!-- ══════════════════════════ Gazebo: camera sensor ═══════════════════ -->

  <gazebo reference="camera_link">
    <sensor name="ball_arm_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60 deg, matches arm_config.yaml -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>10</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- ══════════════════════════ Gazebo: link colors ═══════════════════ -->

  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link1"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="link2"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link3"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="link4"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="link5"><material>Gazebo/Orange</material></gazebo>
  <gazebo reference="end_effector_link"><material>Gazebo/Black</material></gazebo>

  <!-- ══════════════════════════ ros2_control ═══════════════════════════ -->

  <ros2_control name="arm_6dof_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find-pkg-share ball_arm_project)/config/arm_controllers.yaml</parameters>
      <!-- If not installed as a ROS package, launch_sim.py passes an absolute
           path override for this file at launch time. -->
    </plugin>
  </gazebo>

</robot>
